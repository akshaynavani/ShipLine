# Copy to <service-dir>/.env for local runs. Never commit the real file.
# AWS credentials themselves come from your normal AWS CLI setup (SSO profile,
# AWS_PROFILE, or env vars) - ShipLine never reads or stores them.
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
SHIPLINE_EKS_CLUSTER=shipline-demo
SHIPLINE_NAMESPACE=hello

# Optional
# SHIPLINE_SKIP_KUBECONFIG=1       # use current kube context (kind/minikube)
# SHIPLINE_RELEASE_STORE=local     # keep release history in .shipline/ instead of a ConfigMap
# SHIPLINE_LOG_LEVEL=DEBUG
# SHIPLINE_VAR_REPLICAS=3          # exposed to manifests as ${REPLICAS}
